#!/bin/bash
{% include '_sbatch_header.j2' %}
#SBATCH --array=0-{{ array_max }}{% if array_simultaneous %}%{{ array_simultaneous }}{% endif %}
#SBATCH -o {{ scratch_root }}/logs/%x_%A_%a.out
#SBATCH -e {{ scratch_root }}/logs/%x_%A_%a.err

# === Environment Setup ===
{% for mod in modules %}
module load {{ mod }}
{% endfor %}
{% if conda_env and conda_env != 'base' %}
export PATH=$HOME/.conda/envs/{{ conda_env }}/bin:$PATH
{% endif %}

# === Working Directory ===
cd {{ scratch_root }}/projects/{{ project }}

# === Select Config by Array Index ===
CONFIG_DIR="{{ config_dir }}"
CONFIG_FILE="${CONFIG_DIR}/config_$(printf '%03d' ${SLURM_ARRAY_TASK_ID}).yaml"

export EXPERIMENT_ID="{{ project }}_${SLURM_ARRAY_TASK_ID}"
export CONFIG_PATH="${CONFIG_FILE}"
export WANDB_MODE=offline

python {{ script }} --config ${CONFIG_FILE} {{ args }}

# === Record Completion ===
EXIT_CODE=$?
echo "EXPERIMENT_DONE: $EXPERIMENT_ID exit_code=${EXIT_CODE}" >> {{ scratch_root }}/logs/completed.log
exit ${EXIT_CODE}
