#!/bin/bash
{% include '_sbatch_header.j2' %}
{%- if dependency_job_id %}
#SBATCH --dependency=afterok:{{ dependency_job_id }}
{%- endif %}
#SBATCH -o {{ scratch_root }}/logs/%x_%j.out
#SBATCH -e {{ scratch_root }}/logs/%x_%j.err

# === Environment Setup ===
{% for mod in modules %}
module load {{ mod }}
{% endfor %}

# === Working Directory ===
cd {{ scratch_root }}/projects/{{ project }}

# === Stage: {{ stage_name }} ===
export EXPERIMENT_ID="{{ exp_id }}"
export STAGE_NAME="{{ stage_name }}"
export CONFIG_PATH="{{ config_path }}"
export WANDB_MODE=offline

# === Python invocation ===
# Wraps `python {script} {args}` according to environment.type declared in the
# experiment.yaml. Without this branch, the host system python is used and
# every K-UBM import fails immediately. (BUG-K1 fix.)
{% if env_type == "singularity" %}
# Singularity: --nv binds host NVIDIA driver, --bind makes scratch visible.
singularity exec --nv \
    --bind {{ scratch_root }}:{{ scratch_root }} \
    {{ env_container }} \
    python {{ script }} {{ args }}
{% elif env_type == "conda" %}
# User conda env at {{ scratch_root }}/.conda_envs/{{ conda_env }} (we keep
# packages off /home01 due to KISTI's tight quota; see dev_status.md).
source /apps/applications/Miniconda/25.11.1/etc/profile.d/conda.sh
export CONDA_ENVS_PATH={{ scratch_root }}/.conda_envs:$CONDA_ENVS_PATH
conda activate {{ conda_env }}
python {{ script }} {{ args }}
{% else %}
# Fallback: rely on PATH/modules already loaded above.
python {{ script }} {{ args }}
{% endif %}

EXIT_CODE=$?
echo "STAGE_DONE: ${STAGE_NAME} exp=${EXPERIMENT_ID} exit_code=${EXIT_CODE}" >> {{ scratch_root }}/logs/completed.log
exit ${EXIT_CODE}
