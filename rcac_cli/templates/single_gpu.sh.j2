#!/bin/bash
{% include '_sbatch_header.j2' %}
#SBATCH -o {{ scratch_root }}/logs/%x_%j.out
#SBATCH -e {{ scratch_root }}/logs/%x_%j.err

# === Environment Setup ===
{% for mod in modules %}
module load {{ mod }}
{% endfor %}

# === Working Directory ===
cd {{ scratch_root }}/projects/{{ project }}

# === Experiment ===
export EXPERIMENT_ID="{{ exp_id }}"
export CONFIG_PATH="{{ config_path }}"
export WANDB_MODE=offline

# === Python invocation === (honours environment.type)
{% if env_type == "apptainer" %}
apptainer exec --nv \
    {{ env_container }} \
    python {{ script }} {{ args }}
{% elif env_type == "conda" %}
module load use.own
module load conda-env/{{ conda_env }}
python {{ script }} {{ args }}
{% else %}
python {{ script }} {{ args }}
{% endif %}

# === Record Completion ===
EXIT_CODE=$?
echo "EXPERIMENT_DONE: $EXPERIMENT_ID exit_code=${EXIT_CODE}" >> {{ scratch_root }}/logs/completed.log
exit ${EXIT_CODE}
