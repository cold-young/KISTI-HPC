#!/bin/bash
{% include '_sbatch_header.j2' %}
#SBATCH -o {{ scratch_root }}/logs/%x_%j.out
#SBATCH -e {{ scratch_root }}/logs/%x_%j.err

# === Environment Setup ===
{% for mod in modules %}
module load {{ mod }}
{% endfor %}

# === Working Directory ===
cd {{ scratch_root }}/projects/{{ project }}

# === Experiment ===
export EXPERIMENT_ID="{{ exp_id }}"
export CONFIG_PATH="{{ config_path }}"
export WANDB_MODE=offline
export MASTER_ADDR=$(hostname)
export MASTER_PORT=29500

# === Distributed launch === (BUG-K1 fix: respect environment.type)
{% if env_type == "singularity" %}
singularity exec --nv \
    --bind {{ scratch_root }}:{{ scratch_root }} \
    {{ env_container }} \
    torchrun --nproc_per_node={{ gpus_per_node }} --nnodes={{ nodes }} \
        --master_addr=${MASTER_ADDR} --master_port=${MASTER_PORT} \
        {{ script }} {{ args }}
{% elif env_type == "conda" %}
source /apps/applications/Miniconda/25.11.1/etc/profile.d/conda.sh
export CONDA_ENVS_PATH={{ scratch_root }}/.conda_envs:$CONDA_ENVS_PATH
conda activate {{ conda_env }}
torchrun --nproc_per_node={{ gpus_per_node }} --nnodes={{ nodes }} \
    --master_addr=${MASTER_ADDR} --master_port=${MASTER_PORT} \
    {{ script }} {{ args }}
{% else %}
torchrun --nproc_per_node={{ gpus_per_node }} --nnodes={{ nodes }} \
    --master_addr=${MASTER_ADDR} --master_port=${MASTER_PORT} \
    {{ script }} {{ args }}
{% endif %}

# === Record Completion ===
EXIT_CODE=$?
echo "EXPERIMENT_DONE: $EXPERIMENT_ID exit_code=${EXIT_CODE}" >> {{ scratch_root }}/logs/completed.log
exit ${EXIT_CODE}
