# Python
.DS_Store
# `python -m build` output. The C2 packaging gate builds a wheel, and an
# untracked dist/ would otherwise dirty every subsequent `git status`.
dist/
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb
**/.history
**/*.h5
**/*.hdf5
**/*.npy
**/*.csv
**/*.data

# Docker/Singularity
**/*.sif
docker/cluster/exports/
docker/.container.cfg

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!.vscode

# Outputs
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp
**/*.pt
**/*.npz

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
_isaac_sim*
_repo
_build
_backup
.lastformat

# RL-Games
**/runs/*
**/logs/*
**/recordings/*
