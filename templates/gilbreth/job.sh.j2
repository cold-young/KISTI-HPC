#!/bin/bash
# Generated by gilbreth-cli — Purdue RCAC Gilbreth
#SBATCH -J {{ job_name | shell_quote }}
#SBATCH -A {{ account }}
#SBATCH -p {{ partition }}
#SBATCH -q {{ qos }}
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node={{ gpus }}
#SBATCH --cpus-per-gpu={{ cpus_per_gpu }}
#SBATCH --mem={{ mem }}
#SBATCH --time={{ time }}
{% if constraint %}
#SBATCH --constraint={{ constraint }}
{% endif %}
{% if dependency_job_id %}
#SBATCH --dependency=afterok:{{ dependency_job_id }}
{% endif %}
{% if array_max is not none %}
#SBATCH --array=0-{{ array_max }}{% if array_parallel %}%{{ array_parallel }}{% endif %}

#SBATCH -o {{ logs_dir }}/%x_%A_%a.out
#SBATCH -e {{ logs_dir }}/%x_%A_%a.err
{% else %}
#SBATCH -o {{ logs_dir }}/%x_%j.out
#SBATCH -e {{ logs_dir }}/%x_%j.err
{% endif %}
{% if mail_user %}
#SBATCH --mail-user={{ mail_user }}
#SBATCH --mail-type={{ mail_type }}
{% endif %}

set -o pipefail
echo "=== Job $SLURM_JOB_ID on $(hostname) | partition={{ partition }} qos={{ qos }} gpus={{ gpus }} ==="
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || true

# === Modules ===
module purge 2>/dev/null
{% if base_module %}
# '{{ base_module }}' restores the login stack (gcc, openmpi, cuda/12.6.0, external). Without 'external',
# Lmod cannot see conda / anaconda / cuda-13 at all ("exist but cannot be loaded as requested").
module load {{ base_module }} || { echo "ERROR: module load {{ base_module }} failed"; exit 1; }
{% endif %}
{% if env_type in ("conda", "conda-env-mod") %}
module load {{ conda_module }} || { echo "ERROR: module load {{ conda_module }} failed (module spider conda)"; exit 1; }
command -v conda >/dev/null || { echo "ERROR: conda not on PATH after module load"; exit 1; }
{% endif %}
{% for mod in modules %}
module load {{ mod }} || { echo "ERROR: module load {{ mod }} failed (module spider {{ mod }})"; exit 1; }
{% endfor %}

# === Environment === (after module loads: the conda module resets CONDA_PKGS_DIRS to $HOME)
{% for key, value in env_vars.items() %}
export {{ key }}={{ value | string | shell_quote }}
{% endfor %}
export PROJECT="{{ project }}"
{% if array_max is not none %}
export EXPERIMENT_ID="{{ exp_id }}_$(printf '%03d' $SLURM_ARRAY_TASK_ID)"
export CONFIG_PATH="{{ config_dir }}/config_$(printf '%03d' $SLURM_ARRAY_TASK_ID).yaml"
export ARGS_FILE="{{ config_dir }}/args_$(printf '%03d' $SLURM_ARRAY_TASK_ID).txt"
{% else %}
export EXPERIMENT_ID="{{ exp_id }}"
export CONFIG_PATH="{{ config_path }}"
{% endif %}
{% if stage_name %}
export STAGE_NAME="{{ stage_name }}"
{% endif %}
export MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)
export MASTER_PORT=$((20000 + SLURM_JOB_ID % 20000))

cd {{ workdir | shell_quote }} || { echo "ERROR: project dir {{ workdir }} missing (run gilbreth-sync push)"; exit 1; }

{% if env_type == "conda" %}
eval "$(conda shell.bash hook)" || { echo "ERROR: conda module not loaded"; exit 1; }
conda activate {{ env_ref | shell_quote }} || { echo "ERROR: conda activate {{ env_ref }} failed"; exit 1; }
{% elif env_type == "conda-env-mod" %}
module load use.own
module load conda-env/{{ env_ref }} || { echo "ERROR: module conda-env/{{ env_ref }} not found"; exit 1; }
{% elif env_type == "venv" %}
source {{ env_ref | shell_quote }}/bin/activate || { echo "ERROR: venv {{ env_ref }} missing"; exit 1; }
{% endif %}
echo "python: $(command -v python)"

# === Run ===
{% if env_type == "apptainer" %}
RUNNER="apptainer exec --nv --bind {{ scratch }}{% if depot %} --bind {{ depot }}{% endif %} {{ container }}"
{% else %}
RUNNER=""
{% endif %}
{% if array_max is not none %}
# per-task arguments, parsed by bash exactly as if typed (quotes honoured)
eval "set -- $(cat "$ARGS_FILE")"
{% set run_args = '"$@"' %}
{% else %}
{% set run_args = args %}
{% endif %}
{% if launcher == "torchrun" and nodes > 1 %}
srun $RUNNER torchrun \
    --nnodes=$SLURM_NNODES --nproc_per_node={{ gpus }} \
    --rdzv_backend=c10d --rdzv_endpoint=$MASTER_ADDR:$MASTER_PORT \
    {{ script }} {{ run_args }}
{% elif launcher == "torchrun" %}
$RUNNER torchrun --standalone --nproc_per_node={{ gpus }} {{ script }} {{ run_args }}
{% elif script %}
$RUNNER python {{ script }} {{ run_args }}
{% else %}
$RUNNER bash -c {{ command | shell_quote }}
{% endif %}
EXIT_CODE=$?

echo "=== Done: exit_code=${EXIT_CODE} ==="
echo "$(date +%FT%T) job=$SLURM_JOB_ID exp=${EXPERIMENT_ID}{% if stage_name %} stage=${STAGE_NAME}{% endif %} exit=${EXIT_CODE}" >> {{ logs_dir }}/completed.log
exit ${EXIT_CODE}
