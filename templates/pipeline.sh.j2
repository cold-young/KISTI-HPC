#!/bin/bash
#SBATCH -J {{ project }}_{{ stage_name }}_{{ exp_id }}
#SBATCH -p {{ partition }}
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:{{ gpus }}
#SBATCH --cpus-per-gpu={{ cpus_per_gpu }}
#SBATCH --time={{ time }}
#SBATCH --comment {{ comment }}
{% if dependency_job_id %}
#SBATCH --dependency=afterok:{{ dependency_job_id }}
{% endif %}
#SBATCH -o /scratch/{{ user }}/logs/%x_%j.out
#SBATCH -e /scratch/{{ user }}/logs/%x_%j.err

# === Environment Setup ===
{% for mod in modules %}
module load {{ mod }}
{% endfor %}
{% if conda_env and conda_env != 'base' %}
export PATH=$HOME/.conda/envs/{{ conda_env }}/bin:$PATH
{% endif %}

# === Working Directory ===
cd /scratch/{{ user }}/projects/{{ project }}

# === Stage: {{ stage_name }} ===
export EXPERIMENT_ID="{{ exp_id }}"
export STAGE_NAME="{{ stage_name }}"
export CONFIG_PATH="{{ config_path }}"
export WANDB_MODE=offline

python {{ script }} {{ args }}

EXIT_CODE=$?
echo "STAGE_DONE: ${STAGE_NAME} exp=${EXPERIMENT_ID} exit_code=${EXIT_CODE}" >> /scratch/{{ user }}/logs/completed.log
exit ${EXIT_CODE}
