#!/bin/bash
#SBATCH -J {{ project }}_{{ exp_id }}
#SBATCH -p {{ partition }}
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:{{ gpus }}
#SBATCH --cpus-per-gpu={{ cpus_per_gpu }}
#SBATCH --time={{ time }}
#SBATCH --comment {{ comment }}
#SBATCH -o /scratch/{{ user }}/logs/%x_%j.out
#SBATCH -e /scratch/{{ user }}/logs/%x_%j.err

# === Environment Setup ===
{% for mod in modules %}
module load {{ mod }}
{% endfor %}

# === Working Directory ===
cd /scratch/{{ user }}/projects/{{ project }}

# === Experiment ===
export EXPERIMENT_ID="{{ exp_id }}"
export CONFIG_PATH="{{ config_path }}"
export WANDB_MODE=offline

# === Python invocation === (BUG-K1 fix: respect environment.type)
{% if env_type == "singularity" %}
singularity exec --nv \
    --bind /scratch/{{ user }}:/scratch/{{ user }} \
    {{ env_container }} \
    python {{ script }} {{ args }}
{% elif env_type == "conda" %}
source /apps/applications/Miniconda/25.11.1/etc/profile.d/conda.sh
export CONDA_ENVS_PATH=/scratch/{{ user }}/.conda_envs:$CONDA_ENVS_PATH
conda activate {{ conda_env }}
python {{ script }} {{ args }}
{% else %}
python {{ script }} {{ args }}
{% endif %}

# === Record Completion ===
EXIT_CODE=$?
echo "EXPERIMENT_DONE: $EXPERIMENT_ID exit_code=${EXIT_CODE}" >> /scratch/{{ user }}/logs/completed.log
exit ${EXIT_CODE}
